# ========================================
# CityScholar-Agent 环境变量配置模板
# ========================================
# 使用方法：
#   1. 复制此文件为 .env：cp .env.example .env
#   2. 将下方的占位符替换为你的真实 API Key
#   3. .env 文件已被 .gitignore 排除，不会被提交到 Git
# ========================================

# ====== DashScope（阿里云通义千问：chat + embedding） ======
# 注册地址：https://dashscope.aliyun.com/
DASHSCOPE_API_KEY=your-dashscope-api-key-here
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
DASHSCOPE_ANSWER_MODEL=qwen-plus
DASHSCOPE_ANALYSIS_MODEL=qwen-max
DASHSCOPE_EMBEDDING_MODEL=text-embedding-v3
DASHSCOPE_TIMEOUT_SEC=45
DASHSCOPE_EMBEDDING_DIMENSIONS=512

# ====== DeepSeek（chat 优先） ======
# 注册地址：https://platform.deepseek.com/
DEEPSEEK_API_KEY=your-deepseek-api-key-here
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# ====== 知识库参数（可选，使用默认值即可） ======
KB_CHUNK_SIZE=800
KB_CHUNK_OVERLAP=150
KB_TOP_K=5
